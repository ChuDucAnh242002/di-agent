{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.22.0/.schema/devbox.schema.json",
  "packages": [
    "go@1.26.5",
    "python@3.11.18",
    "nodejs@22.23.5"
  ],
  "shell": {
    "scripts": {
      "doctor": [
        "go version",
        "python --version",
        "node --version",
        "npm --version"
      ],
      "test": [
        "bash .github/scripts/devbox-smoke.sh"
      ],
      "setup": "node .github/scripts/devbox-workspace.mjs setup",
      "pull": "node .github/scripts/devbox-workspace.mjs pull",
      "deploy-all": "node .github/scripts/devbox-workspace.mjs deploy-all",
      "deploy": "node .github/scripts/devbox-workspace.mjs deploy \"$@\"",
      "build-agent": "cd semantic-map/go && CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o \"$1\" ./cmd/agent/"
    }
  }
}
